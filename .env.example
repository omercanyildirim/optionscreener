# Bu değerleri Vercel → Project → Settings → Environment Variables bölümüne gir.
# Gerçek değerleri asla repoya koyma (repo herkese açık).

MASSIVE_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# En az 32 karakter rastgele bir değer, örn: openssl rand -base64 48
SESSION_SECRET=
# Giriş yapabilecek Google hesapları, virgülle ayrılmış
ALLOWED_EMAILS=
# Sitenin kalıcı adresi (Google'a kayıtlı yönlendirme adresiyle aynı olmalı)
APP_URL=https://optionscreener.vercel.app
# İsteğe bağlı: veri yenileme aralığı (ms), varsayılan 2000
POLL_MS=2000
